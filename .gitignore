# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Local/editor files
.DS_Store
.idea/
.vscode/

# Raw and derived medical data should not be committed by default.
data/raw/**
!data/raw/
!data/raw/readme
data/interim/**
!data/interim/
!data/interim/.gitkeep
data/processed/**
!data/processed/
!data/processed/.gitkeep
data/nnunet/**

# Experiment outputs
outputs/**
!outputs/
!outputs/figures/
!outputs/figures/.gitkeep
!outputs/logs/
!outputs/logs/.gitkeep
!outputs/metrics/
!outputs/metrics/.gitkeep
!outputs/predictions/
!outputs/predictions/.gitkeep
!outputs/reports/
!outputs/reports/.gitkeep
